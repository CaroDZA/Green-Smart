generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMINISTRADOR
  COORDINADOR
  OPERARIO
}

enum EtapaCultivo {
  VEGETATIVA
  FLORACION
  FRUCTIFICACION
  MADURACION
  REPOSO
}

enum TipoPlaga {
  PICUDO
  PASADOR
  CHINCHE
  ARANITA
  TRIPS
  COCHINILLA
  BARRENADOR
  OTRA
}

enum TipoEnfermedad {
  MARCHITEZ
  PUDRICION_RAIZ
  ANTRACNOSIS
  OTRA
}

enum EstadoCultivo {
  BUENO
  REGULAR
  CRITICO
}

enum TipoActividad {
  PLATEO
  DESHIERBE
  FERTILIZACION
  RIEGO
  PODA
  FUMIGACION
  COSECHA
  MONITOREO
  OTRA
}

enum EstadoActividad {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

model Usuario {
  id         Int         @id @default(autoincrement())
  nombre     String
  email      String      @unique
  password   String
  rol        Rol         @default(OPERARIO)
  activo     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  monitoreos Monitoreo[]

  // Relaciones para las tareas
  actividadesAsignadas Actividad[] @relation("AsignadoA")
  actividadesCreadas   Actividad[] @relation("CreadoPor")
}

model Lote {
  id          Int          @id @default(autoincrement())
  nombre      String
  ubicacion   String
  area        Float?
  descripcion String?
  cultivo     String       @default("Aguacate")
  activo      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  actividades Actividad[]
  etapas      Etapa[]
  monitoreos  Monitoreo[]
}

model Etapa {
  id          Int          @id @default(autoincrement())
  nombre      EtapaCultivo
  fechaInicio DateTime
  fechaFin    DateTime?
  descripcion String?
  loteId      Int
  lote        Lote         @relation(fields: [loteId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Actividad {
  id              Int              @id @default(autoincrement())
  tipo            TipoActividad
  descripcion     String?
  fechaProgramada DateTime
  fechaEjecucion  DateTime?
  estado          EstadoActividad  @default(PENDIENTE)
  novedades       String?
  costo           Float?
  loteId          Int
  lote            Lote             @relation(fields: [loteId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  creadoPorId Int?
  creadoPor   Usuario? @relation("CreadoPor", fields: [creadoPorId], references: [id])

  asignadoAId Int?
  asignadoA   Usuario? @relation("AsignadoA", fields: [asignadoAId], references: [id])
}

model Monitoreo {
  id                 Int              @id @default(autoincrement())
  fecha              DateTime         @default(now())
  condicionObservada String
  estado             EstadoCultivo
  plaga              TipoPlaga?
  enfermedad         TipoEnfermedad?
  observaciones      String?
  loteId             Int
  lote               Lote             @relation(fields: [loteId], references: [id], onDelete: Cascade)
  usuarioId          Int
  usuario            Usuario          @relation(fields: [usuarioId], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}